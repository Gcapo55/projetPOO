    %% ===== CORPUS HIERARCHY =====
    class Corpus {
        +str nom
        +int occurrences
        +compter() void
    }
    
    class Personnage {
        +list attributs
        +str|None genre
    }
    
    class Lieu {
        +str|None categorie
    }
    
    class Evenement {
        +str|None date
        +str|None heure
        +Lieu|None lieu
        +list participants
        +__str__() str
    }
    
    Corpus <|-- Personnage : inherits
    Corpus <|-- Lieu : inherits
    Corpus <|-- Evenement : inherits
    Evenement --> Lieu : references
    Evenement --> Personnage : contains
    
    %% ===== TEXT SPLITTER HIERARCHY =====
