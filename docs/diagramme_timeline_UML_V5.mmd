                AnalyseTexte->>AnalyseTexte: create Personnage and compter()
            else personnage exists
                AnalyseTexte->>AnalyseTexte: increment occurrences
            end
        else entity is LOC/GPE
            AnalyseTexte->>Utils: nettoyer(ent.text)
            AnalyseTexte->>AnalyseTexte: _ajouter_lieu(nom)
            alt lieu new
                AnalyseTexte->>AnalyseTexte: create Lieu and compter()
            else lieu exists
                AnalyseTexte->>AnalyseTexte: increment occurrences
            end
        end
    end

