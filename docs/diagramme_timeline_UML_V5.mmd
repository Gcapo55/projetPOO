    loop each sentence in Doc.sents
        AnalyseTexte->>FonctionsEvenement: trouver_lieu(ent.text, lieux)
        FonctionsEvenement-->>AnalyseTexte: Lieu or None
        AnalyseTexte->>FonctionsEvenement: trouver_participants(ent.text, personnages)
